# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/

# uv
uv.lock

# Data（大容量・再生成可能）
data/raw/
data/processed/
data/output/oof/
data/output/models/
data/output/submissions/

# 外部データ（Kaggle Datasets/公開 Notebook 等から再取得可能）
data/external/

# 可視化画像（大容量）
data/output/plots/

# 学習アーティファクト
catboost_info/
mlruns/
experiments/mlflow/

# 圧縮・一時ファイル
*.zip
*.tar.gz

# ルート直下の一時/外部ログ（コンペ調査時にダウンロードした他者 Notebook 等）
/*.log
/submission.csv

# 外部 blending 出力ディレクトリ（コンペ調査用）
/outputs/

# .claude 内のセッション状態・個人設定
# settings.local.json は「その環境の許可設定」であり配布物ではない。
# ここに書かないと、clone した環境で個人の許可リストが追跡対象になる
# （このリポジトリでは長らくユーザーのグローバル gitignore に偶然救われていた）。
.claude/settings.local.json
.claude/projects/
.claude/scheduled_tasks.lock

# Optuna study の永続化DB（再生成可能。最良HPは best_params_*.json に別途保存される）
data/output/params/optuna_studies/

# 実行中ジョブのハートビート（プロセス固有。共有しない）
experiments/.running/
# pytest の最終実行時刻（session_audit がテスト鮮度の判定に使う）
experiments/.pytest_last_run
# statusLine が読む提出枠キャッシュ（deadline_status が API を叩いたついでに書く）
experiments/.statusline_cache.json
# fold 単位チェックポイント（再開用の一時成果物）
data/output/oof/_foldcache/
# hook 発火の実測ログ（scripts/hook_status.py が読む）
experiments/.hook_log

# Kaggle Notebook の成果物とコンペ固有の .ipynb
# テンプレート本体に置くのは README（手順）だけ。実行結果・push 用ファイル・
# コンペごとの Notebook はコンペブランチに残す
# （main に 106MB のコンペ成果物が混入していたため 2026-09-02 に整理した）
kaggle_nb/*.ipynb
kaggle_nb/output/
kaggle_nb/push*/

# 秘匿情報（API キー・認証情報）。誤って追跡しないための備え
.env
.env.*
*.pem
*credentials*.json
kaggle.json
